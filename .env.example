# Visitor map database.
# Production (Vercel, serverless): MongoDB Atlas. MONGODB_URI is the connection string of a user with readWrite on MONGODB_DB.
MONGODB_URI=
MONGODB_DB=cour-epro

# Alternative: serverless SQLite on Turso (used when MONGODB_URI is empty). Leave both empty in local dev: it falls back to ./data/visits.db
# Create one: https://turso.tech  ->  turso db create cour-epro  ->  turso db show cour-epro --url  ->  turso db tokens create cour-epro
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
